NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=expense_tracker

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=1d
# Optionally allow another frontend origin in addition to the production frontend.
# FRONTEND_ORIGIN=http://localhost:5173

SFTP_HOST=files.internal.yourcompany.com
SFTP_PORT=22
SFTP_USER=expense-api
# Set this to the private key on the machine running the backend.
# Windows example: C:/Users/your-user/.ssh/expense-api_ed25519
SFTP_PRIVATE_KEY_PATH=/etc/expense-api/id_ed25519
# Optional inline key with escaped newlines. Takes precedence over the key path.
# SFTP_PRIVATE_KEY=
# For password authentication, unset both key settings and set SFTP_PASSWORD.
# SFTP_PASSWORD=
# Set this to the parent of receipts/ as seen by the SFTP account.
SFTP_BASE_PATH=/

APP_TIMEZONE=Asia/Kolkata

SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

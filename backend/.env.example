NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=yourpassword
DB_NAME=expense_tracker

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=1d

# Use local for development without an SFTP server.
STORAGE_DRIVER=sftp
# LOCAL_STORAGE_PATH=.receipt-storage
SFTP_HOST=files.internal.yourcompany.com
SFTP_PORT=22
SFTP_USER=expense-api
# Set this to the private key on the machine running the backend.
# Windows example: C:/Users/your-user/.ssh/expense-api_ed25519
SFTP_PRIVATE_KEY_PATH=/etc/expense-api/id_ed25519
# For password authentication, remove SFTP_PRIVATE_KEY_PATH and set SFTP_PASSWORD.
# SFTP_PASSWORD=
SFTP_BASE_PATH=/srv/expense-files/private

APP_TIMEZONE=Asia/Kolkata

SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
